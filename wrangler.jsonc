{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "click-web",
  "main": ".open-next/worker.js",
  // After 2025-04-01, nodejs_compat populates process.env by default. We also set the
  // flag explicitly so dashboard Runtime variables (SUPABASE_*, etc.) are visible to
  // API routes — without this, chat gatekeeper throws "Missing NEXT_PUBLIC_SUPABASE_URL…".
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Local `wrangler deploy` runs this first. Workers Builds does *not* honor
  // wrangler custom builds — dashboard `npm run build` uses WORKERS_CI=1 to
  // run OpenNext (see scripts/ci-next-or-worker-build.sh).
  "build": {
    "command": "bash scripts/materialize-ci-env.sh && npx opennextjs-cloudflare build"
  },
  // Non-secret public site URL. Supabase / LiveKit / Stripe stay in the
  // Workers dashboard so `deploy -- --keep-vars` does not wipe them.
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://joinclick.co"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "click-web"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  // Workers Rate Limiting (shared across isolates in a colo). Falls back to
  // process-local Maps in `next dev` when bindings are unavailable.
  "ratelimits": [
    {
      "name": "CONNECTIONS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "READ_HEAVY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
