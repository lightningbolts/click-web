# Copy to `.env.local` for `next dev`. Do not commit real secrets.
# GitHub Actions copies this file then overlays repo secrets when they are set.
# Cloudflare Worker production secrets stay in the Workers dashboard (`--keep-vars`).

# --- Required (Supabase browser + SSR client) ---
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.placeholder

# --- Public site ---
NEXT_PUBLIC_BASE_URL=https://joinclick.co
NEXT_PUBLIC_APP_LAUNCHED=false
NEXT_PUBLIC_IOS_STORE_URL=https://joinclick.co
NEXT_PUBLIC_ANDROID_STORE_URL=https://joinclick.co
NEXT_PUBLIC_IOS_APP_ID=6757996346
# Click Places: public /p/{slug} pages (anonymous visitors have no user flag). Unset = 404.
PLACES_PUBLIC_PAGES_ENABLED=

# --- GIF search (optional; the chat GIF button is hidden when unset) ---
# KLIPY app key from https://partner.klipy.com. Public by design: KLIPY requires calls from the browser.
NEXT_PUBLIC_KLIPY_APP_KEY=

# --- Server (optional for `next build`; required at runtime for those features) ---
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=
LIVEKIT_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sign in with Apple token revocation on account deletion (App Store 5.1.1(v)). Unset = deletion
# still works but Apple tokens aren't revoked. Key: developer.apple.com > Keys, "Sign in with Apple"
# enabled for the primary App ID. Private key = the .p8 contents, newlines as literal \n.
APPLE_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
# Optional; defaults to the iOS bundle ID compose.project.click.click.
APPLE_IOS_CLIENT_ID=
STRIPE_PRICE_ID=
# Ticketed events rollout gate (Stripe Connect). Keep false until the launch
# prerequisites in docs/ticketing.md are complete.
TICKETING_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENRICHMENT_WEBHOOK_SECRET=
TICKETMASTER_API_KEY=
BUSINESS_INSIGHTS_DEV_EMAILS=
